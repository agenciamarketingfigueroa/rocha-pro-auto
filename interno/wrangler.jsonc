{
  "name": "rochapro-interno",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "interno.rochaproauto.com.br", "custom_domain": true }],
  "r2_buckets": [{ "binding": "PRIVATE_FILES", "bucket_name": "rochapro-interno" }],
  "ratelimits": [{
    "name": "LOGIN_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }],
  "secrets": {
    "required": ["ADMIN_PASSWORD", "STAFF_PASSWORD", "SESSION_SECRET"]
  }
}
