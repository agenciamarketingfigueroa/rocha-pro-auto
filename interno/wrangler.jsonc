{
  "name": "rochapro-interno",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "interno.rochaproauto.com.br", "custom_domain": true }],
  "assets": {
    "directory": "../.tmp/interno-assets",
    "binding": "PRIVATE_ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "ratelimits": [{
    "name": "LOGIN_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }],
  "secrets": {
    "required": ["ADMIN_PASSWORD", "STAFF_PASSWORD", "SESSION_SECRET"]
  }
}
